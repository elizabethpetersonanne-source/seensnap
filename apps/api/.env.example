APP_NAME=SeenSnap API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seensnap
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
FIREBASE_PROJECT_ID=
APPLE_BUNDLE_ID=
GOOGLE_OAUTH_CLIENT_ID=
APP_AUTH_SECRET=replace-me
APP_AUTH_AUDIENCE=seensnap-mobile
# Netlify QA web build — comma-separated origins allowed to hit the API.
# Leave empty for native-only setups. Example:
#   CORS_ALLOWED_ORIGINS=https://seensnap-alpha.netlify.app,https://alpha.seensnap.com
CORS_ALLOWED_ORIGINS=
# Optional regex for per-deploy Netlify preview URLs. Example:
#   CORS_ALLOWED_ORIGIN_REGEX=^https://.*--seensnap-alpha\.netlify\.app$
CORS_ALLOWED_ORIGIN_REGEX=

# Oct-18 build brief §4 Concierge AI adapter. Pick ONE provider.
#
# Vertex AI (Google Cloud Gemini) — recommended for Cloud Run.
#   Auth is Application Default Credentials; no API key.
#   Attach a service account with the "Vertex AI User" role.
#   CONCIERGE_AI_PROVIDER=vertex
#   CONCIERGE_AI_MODEL=gemini-2.5-flash          # or gemini-2.5-pro
#   CONCIERGE_AI_PROJECT=                        # defaults to GCP_PROJECT_ID
#   CONCIERGE_AI_LOCATION=us-central1
#
# Anthropic Claude:
#   CONCIERGE_AI_PROVIDER=anthropic
#   CONCIERGE_AI_API_KEY=sk-ant-...
#   CONCIERGE_AI_MODEL=claude-opus-4-7
#
# OpenAI:
#   CONCIERGE_AI_PROVIDER=openai
#   CONCIERGE_AI_API_KEY=sk-...
#   CONCIERGE_AI_MODEL=gpt-4o-mini
CONCIERGE_AI_PROVIDER=
CONCIERGE_AI_API_KEY=
CONCIERGE_AI_MODEL=
CONCIERGE_AI_PROJECT=
CONCIERGE_AI_LOCATION=us-central1
