APP_NAME=SeenSnap API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seensnap
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
FIREBASE_PROJECT_ID=
APPLE_BUNDLE_ID=
GOOGLE_OAUTH_CLIENT_ID=
APP_AUTH_SECRET=replace-me
APP_AUTH_AUDIENCE=seensnap-mobile
# Netlify QA web build — comma-separated origins allowed to hit the API.
# Leave empty for native-only setups. Example:
#   CORS_ALLOWED_ORIGINS=https://seensnap-alpha.netlify.app,https://alpha.seensnap.com
CORS_ALLOWED_ORIGINS=
# Optional regex for per-deploy Netlify preview URLs. Example:
#   CORS_ALLOWED_ORIGIN_REGEX=^https://.*--seensnap-alpha\.netlify\.app$
CORS_ALLOWED_ORIGIN_REGEX=
