{
  "expo": {
    "name": "SeenSnap",
    "slug": "seensnap",
    "owner": "gregtusar",
    "scheme": "seensnap",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/branding/seensnap-logo.png",
    "splash": {
      "image": "./assets/branding/seensnap-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1424"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/seensnap-logo.png",
          "color": "#f4c430",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SeenSnap uses the photo you choose for your profile, team picture or bug report.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "easProjectId": ""
    },
    "ios": {
      "bundleIdentifier": "com.seensnap.app",
      "associatedDomains": [
        "applinks:seensnap.app"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "supportsTablet": true
    },
    "android": {
      "package": "com.seensnap.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/seensnap-logo.png",
        "backgroundColor": "#0b1424"
      },
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/lists"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/titles"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/list/"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/profile/"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/post/"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/share/t/"
            },
            {
              "scheme": "https",
              "host": "seensnap.app",
              "pathPrefix": "/teams/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/seensnap-logo.png"
    }
  }
}
