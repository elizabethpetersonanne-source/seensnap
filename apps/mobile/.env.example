# SeenSnap mobile — env template.
#
# Anything prefixed EXPO_PUBLIC_* is BAKED INTO THE JS BUNDLE at build time
# and is therefore visible to anyone who downloads the app / opens the
# web build. NEVER put real private secrets here.
#
# Local dev copies this file to `.env.local` and fills real values.
# Netlify sets these as environment variables in the site settings.

# ─── API ────────────────────────────────────────────────────────────────
# Points the app at the SeenSnap backend. Include the /api/v1 prefix.
#
# Local dev:      typically auto-resolved from the Expo tunnel host, but
#                 you can override:
#                   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Netlify (QA):   set this to the staging API URL, e.g.
#                   EXPO_PUBLIC_API_BASE_URL=https://api-staging.seensnap.app/api/v1
# Production:     set to the production API URL.
EXPO_PUBLIC_API_BASE_URL=

# ─── Google OAuth (public client IDs, safe to bundle) ───────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials.
# The web client is used by browser sign-in; iOS/Android clients ship in
# native builds only. All three are safe to put in the browser bundle —
# OAuth security lives in the redirect-URI allow-list on Google's side,
# not in secrecy of the client id.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ─── Environment banner (optional) ──────────────────────────────────────
# When set, some surfaces show a small banner so testers know they're on
# the QA build. Empty in production.
#   EXPO_PUBLIC_ENVIRONMENT=staging
EXPO_PUBLIC_ENVIRONMENT=
